# Supabase (auto-injected in production, needed for local dev)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenRouter — operator key for subsidized LLM calls
# Get yours at https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxx

# Lemon Squeezy webhook secret
# Set in your Lemon Squeezy dashboard → Webhooks
LEMON_WEBHOOK_SECRET=your-webhook-secret-here

# Lemon Squeezy variant IDs (from your products/variants page)
LEMON_VARIANT_PRO=123456
LEMON_VARIANT_TEAM=123457

# Encryption secret for BYOK keys stored in DB
# Generate: openssl rand -hex 32
BYOK_ENCRYPTION_SECRET=your-32-byte-hex-secret-here
